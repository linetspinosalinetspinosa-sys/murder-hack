-- === FUNCIONES UTILITARIAS ===
local function getPlayerByName(name)
    for _, p in pairs(game.Players:GetPlayers()) do
        if p.Name:lower() == name:lower() or p.DisplayName:lower() == name:lower() then
            return p
        end
    end
    return nil
end

local function findRemote(name)
    for _, v in pairs(game:GetDescendants()) do
        if v:Isa("RemoteEvent") and v.Name:lower():find(name:lower()) then
            return v
        end
    end
    for _, v in pairs(game:GetDescendants()) do
        if v:isa("RemoteFunction") and v.Name:lower():find(name:lower()) then
            return v
        end
    end
    return nil
end


local function dropAllTools()
    for _, tool in pairs(Player.Backpack:GetChildren()) do
        tool.Parent = workspace
    end
    for _, tool in pairs(Player.Character and Player.Character:GetChildren() or {}) do
        if tool:Isa("Tool") then
            tool.Parent = workspace
        end
    end
end

